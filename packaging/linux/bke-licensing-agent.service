[Unit]
Description=BKE Licensing Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/bke-digital-solutions/licensing-agent/agent/bke-licensing-agent serve
Environment=BKE_AGENT_DATA_DIR=/var/lib/bke-digital-solutions/licensing-agent
Restart=on-failure
RestartSec=5
User=bke-licensing-agent
Group=bke-licensing-agent
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bke-digital-solutions/licensing-agent

[Install]
WantedBy=multi-user.target
