#!/bin/bash
set -euo pipefail

LABEL="com.bkedigitalsolutions.licensing-agent"
PLIST="/Library/LaunchDaemons/${LABEL}.plist"
DATA_DIR="/Library/Application Support/BKE Digital Solutions/Licensing Agent Data"
LOG_DIR="/Library/Logs/BKE Digital Solutions"

mkdir -p "$DATA_DIR/trusted-keys" "$LOG_DIR"
chmod 755 "$DATA_DIR" "$DATA_DIR/trusted-keys" "$LOG_DIR"
chown root:wheel "$PLIST"
chmod 644 "$PLIST"

plutil -lint "$PLIST" >/dev/null

# preinstall normally removes the old job before PackageKit replaces the payload.
# Keep postinstall defensive for fresh installs and interrupted/legacy upgrades.
if launchctl print "system/${LABEL}" >/dev/null 2>&1; then
    launchctl bootout "system/${LABEL}" >/dev/null 2>&1 || \
        launchctl bootout system "$PLIST" >/dev/null 2>&1 || true

    for _ in $(seq 1 40); do
        if ! launchctl print "system/${LABEL}" >/dev/null 2>&1; then
            break
        fi
        sleep 0.25
    done
fi

bootstrap_ok=false
for attempt in 1 2 3 4 5; do
    if launchctl bootstrap system "$PLIST"; then
        bootstrap_ok=true
        break
    fi
    echo "LaunchDaemon bootstrap attempt ${attempt} failed; retrying." >&2
    sleep "$attempt"
done

if [[ "$bootstrap_ok" != "true" ]]; then
    echo "Unable to bootstrap BKE Licensing Agent LaunchDaemon after retries." >&2
    launchctl print-disabled system >&2 || true
    exit 1
fi

launchctl enable "system/${LABEL}"
launchctl kickstart -k "system/${LABEL}"

for _ in $(seq 1 40); do
    if launchctl print "system/${LABEL}" >/dev/null 2>&1; then
        exit 0
    fi
    sleep 0.25
done

echo "BKE Licensing Agent LaunchDaemon was bootstrapped but did not become visible to launchd." >&2
exit 1
