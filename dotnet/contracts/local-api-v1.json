{
  "contract_id": "bke.licensing-agent.local-api",
  "contract_version": 1,
  "bind_host": "127.0.0.1",
  "default_port": 43873,
  "max_json_body_bytes": 32768,
  "max_chunk_line_bytes": 8192,
  "routes": [
    { "method": "GET", "path": "/license-center" },
    { "method": "POST", "path": "/v1/authorize" },
    { "method": "POST", "path": "/v1/activate" },
    { "method": "POST", "path": "/v1/license-center/open" },
    { "method": "POST", "path": "/v1/notifications/request" },
    { "method": "POST", "path": "/v1/notifications/feed" },
    { "method": "POST", "path": "/v1/notifications/mark-read" },
    { "method": "POST", "path": "/v1/notifications/dismiss" },
    { "method": "POST", "path": "/v1/notifications/unread-count" },
    { "method": "POST", "path": "/v1/updates/check" },
    { "method": "POST", "path": "/v1/update-center/open" }
  ],
  "capabilities": {
    "updates": { "capability_id": "bke.updates.check", "contract_version": 1 },
    "typed_notifications": { "capability_id": "bke.notifications.typed", "contract_version": 1 },
    "notification_inbox": { "capability_id": "bke.notifications", "contract_version": 1 }
  },
  "storage_schema_version": 8
}
